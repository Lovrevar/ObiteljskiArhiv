# Vercel → Project → Settings → Environment Variables

# Required for the contact and partner forms (api/contact.ts).
# Create it at resend.com → API Keys, in the account where obiteljski-arhiv.com is verified.
RESEND_API_KEY=

# Optional: override where form emails go and who they come from.
# CONTACT_RECIPIENT=info@obiteljski-arhiv.com
# CONTACT_SENDER=Obiteljski Arhiv <info@obiteljski-arhiv.com>

# Optional: your own Shopify Storefront token (Shopify admin → Headless channel).
# Without these the site uses the token Lovable created.
# VITE_SHOPIFY_STORE_DOMAIN=54i1s7-ec.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=
